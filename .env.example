# Copy to .env (git-ignored) and fill in. The code never contains locations,
# credentials or hosts; everything environment-specific is read from here or
# from the process environment (which takes precedence).

# ---- datasets: where `sentiment-benchmark data download` fetches from ----
# Direct URL of the IMDB archive (aclImdb_v1.tar.gz) from the dataset's page
IMDB_ARCHIVE_URL=
# Kaggle dataset identifiers (owner/dataset-slug) for the two Twitter datasets
KAGGLE_TWITTER_HATE_DATASET=
KAGGLE_VACCINATION_DATASET=
# Kaggle API credentials used by the Kaggle client
KAGGLE_USERNAME=
KAGGLE_KEY=

# ---- operational database (predictions + drift reports) ----
# PostgreSQL in Docker Compose / AWS RDS; leave empty for a local SQLite file
DATABASE_URL=
# e.g. DATABASE_URL=postgresql+psycopg2://sentiment:change-me@localhost:5432/sentiment

# ---- experiment tracking ----
# MLflow server or database; leave empty for sqlite:///reports/mlflow.db
MLFLOW_TRACKING_URI=
# S3 bucket for MLflow artifacts when running the server on AWS
MLFLOW_ARTIFACT_ROOT=

# ---- tweet collection (`sentiment-benchmark collect`) ----
TWITTER_BEARER_TOKEN=

# ---- serving ----
PORT=5000
